  },
  "optimization": {
    "components": [
      {
        "id": "system-prompt",
        "path": "prompts/system.md"
      }
    ],
    "max_candidates": 1
  },
  "objectives": {
    "minimum_pass_rate": 0.8,
    "require_cost": true
  }
}
